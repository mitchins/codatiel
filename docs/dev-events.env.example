# DEV event-pipeline + integrated semdup — operator template.
# Copy to a 600-permission file OUTSIDE the repo and set the values.
# No secrets are stored here; credential env vars must already exist
# in the operator's environment (OPENAI_API_KEY, SMTP2GO_API_KEY).

# Model credentials (required for any inference).
# OPENAI_API_KEY must be exported separately (Terra/Luna).

# Event pipeline identity.
CODATIEL_ENV=dev
CODATIEL_DEV_STATE=./devstate
CODATIEL_DEV_REPOS=owner/repo
CODATIEL_DEV_SPEND_CAP_USD=5
CODATIEL_DEV_TO=reviews@example.com
CODATIEL_DEV_SENDER=codatiel-dev@example.com

# Local checkout override (optional). Without it the pipeline
# maintains its own read-only clone via `gh repo clone`.
CODATIEL_DEV_REPO_PATHS=owner/repo=/path/to/checkout

# Normal review pipeline: terra_luna_additive (default) or terra_only.
REVIEW_PIPELINE=terra_luna_additive

# Integrated duplication stage (all optional; shown with defaults).
CODATIEL_DEV_SEMDUP=1
CODATIEL_DEV_SEMDUP_CEILING_USD=0.20
CODATIEL_DEV_SEMDUP_MAX_PAIRS=4
CODATIEL_DEV_SEMDUP_ALLOW_EMBEDDINGS=1

# Digest transport: fixture (print, no send) or smtp2go (send).
# SMTP2GO_API_KEY must be exported separately for smtp2go.
CODATIEL_EVENTS_TRANSPORT=fixture
