# Codatiel v0.1.0 environment template. Copy to a private file
# (e.g. docker/codatiel-v010.env, chmod 600) and fill in. NEVER commit
# the filled file. Keys live in process env inside the container only.

# ---- GitHub (read-only) ----
# Preferred: private GitHub App (account-wide install, read-only
# metadata/contents/pull-requests). Daemon mints hourly installation
# tokens; nothing here can write.
GITHUB_APP_ID=
# Inline PEM (\\n-escaped ok) or leave empty and use _PATH instead.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_ACCOUNT=mitchins
# GITHUB_INSTALLATION_ID=  (optional; auto-discovered for the account)
# Fallback: read-only token (PAT/fine-grained: contents:read +
# pull-requests:read). Requires an explicit allowlist below.
GH_TOKEN=
# Token mode: explicit allowlist, comma-separated owner/name.
# App mode: leave empty for automatic installation-wide discovery.
CODATIEL_WATCH_REPOS=
# Optional exclusion list, comma-separated (both modes). Empty = all repos.
CODATIEL_WATCH_EXCLUDE=
# Recipients of every shadow email (private mailbox(es), comma-separated).
CODATIEL_WATCH_TO=
# Envelope sender (must be SMTP2GO-verified for the domain).
CODATIEL_WATCH_SENDER=
# ---- Model credentials (paid backends; quota/no-key backends unused) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ---- Outbound email ----
SMTP2GO_API_KEY=
# ---- Tuning (defaults shown) ----
CODATIEL_WATCH_INTERVAL=300
CODATIEL_WATCH_DEBOUNCE=120
CODATIEL_WATCH_SPEND_CAP=5.0
CODATIEL_WATCH_DAILY_CAP=2.0
# Already-spent pilot dollars (M10 research) counted against the cap.
CODATIEL_WATCH_SEED_SPENT=0.389
