# Codatiel v0.1.0 environment template. Copy to a private file
# (e.g. docker/codatiel-v010.env, chmod 600) and fill in. NEVER commit
# the filled file. Keys live in process env inside the container only.

# ---- GitHub (read-only) ----
# Least-privilege classic PAT or fine-grained token: contents:read on the
# allowlisted repos + pull-requests:read. No write scopes.
GH_TOKEN=
# Explicit allowlist, comma-separated owner/name. Only these repos are
# ever polled, cloned, or quoted to models/email.
CODATIEL_WATCH_REPOS=
# Recipients of every shadow email (private mailbox(es), comma-separated).
CODATIEL_WATCH_TO=
# Envelope sender (must be SMTP2GO-verified for the domain).
CODATIEL_WATCH_SENDER=
# ---- Model credentials (paid backends; quota/no-key backends unused) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ---- Outbound email ----
SMTP2GO_API_KEY=
# ---- Tuning (defaults shown) ----
CODATIEL_WATCH_INTERVAL=300
CODATIEL_WATCH_DEBOUNCE=120
CODATIEL_WATCH_SPEND_CAP=5.0
CODATIEL_WATCH_DAILY_CAP=2.0
# Already-spent pilot dollars (M10 research) counted against the cap.
CODATIEL_WATCH_SEED_SPENT=0.389
